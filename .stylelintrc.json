{
	"extends": "@wordpress/stylelint-config/stylistic",
	"rules": {
		"selector-class-pattern": null,
		"at-rule-no-unknown": [
			true,
			{
				"ignoreAtRules": [
					"apply",
					"config",
					"custom-variant",
					"plugin",
					"reference",
					"source",
					"theme",
					"utility",
					"variant"
				]
			}
		]
	}
}
