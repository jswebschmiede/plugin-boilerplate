{
	"name": "jswebforge/plugin-boilerplate",
	"description": "Starting point for WordPress plugins",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Jörg Schöneburg",
			"email": "schoeneburg.j@googlemail.com",
			"homepage": "https://jswebforge.de"
		}
	],
	"support": {
		"issues": "https://github.com/jswebschmiede/plugin-boilerplate/issues"
	},
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"rector/rector": "^2.0",
		"sirbrillig/phpcs-changed": "^2.11",
		"sirbrillig/phpcs-variable-analysis": "^2.12",
		"wp-cli/i18n-command": "^2.6",
		"wp-coding-standards/wpcs": "^3.2"
	},
	"autoload": {
		"psr-4": {
			"Jswebforge\\PluginBoilerplate\\": "src/"
		}
	},
	"scripts": {
		"setup": "@php bin/setup.php",
		"php:lint": "vendor/bin/phpcs -p -s",
		"php:lint:errors": "vendor/bin/phpcs -p -s --runtime-set ignore_warnings_on_exit 1",
		"php:lint:autofix": "vendor/bin/phpcbf",
		"php:lint:changed": "vendor/bin/phpcs-changed --git --git-unstaged",
		"php:rector": "vendor/bin/rector process --dry-run",
		"php:rector:fix": "vendor/bin/rector process",
		"php:rector:clear-cache": "vendor/bin/rector clear-cache",
		"php:rector:fix:lint": [
			"@php:rector:fix",
			"vendor/bin/phpcbf || true",
			"@php:lint"
		],
		"make-pot": "wp i18n make-pot . languages/plugin-boilerplate.pot --exclude=assets,dist,node_modules,vendor",
		"make-mo": "wp i18n make-mo languages",
		"make-json": "wp i18n make-json languages",
		"make-php": "wp i18n make-php languages",
		"i18n": [
			"@build:assets",
			"@make-pot",
			"wp i18n update-po languages/plugin-boilerplate.pot languages",
			"@make-mo",
			"@make-json",
			"@make-php"
		],
		"build:assets": [
			"Composer\\Config::disableProcessTimeout",
			"pnpm install --frozen-lockfile",
			"pnpm run build"
		],
		"playground": [
			"Composer\\Config::disableProcessTimeout",
			"npx @wp-playground/cli@latest start --php=8.3 --blueprint=blueprint.json"
		],
		"production": [
			"Composer\\Config::disableProcessTimeout",
			"@php:lint",
			"@build:assets",
			"@make-mo",
			"@make-json",
			"@make-php",
			"@composer install --no-dev --optimize-autoloader --no-interaction",
			"@php bin/package.php",
			"@composer install --no-interaction"
		]
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
